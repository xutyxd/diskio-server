{
    "get": {
        "tags": [ "DiskIO" ],
        "summary": "List files",
        "responses": {
            "200": {
                "description": "File names",
                "content": {
                    "application/json": {
                        "schema": {
                            "example": {
                                "$ref": "../examples/diskio-file.example.json"
                            },
                            "allOf": [
                                {
                                    "$ref": "../../common/response.model.json"
                                },
                                {
                                    "type": "object",
                                    "required": ["response"],
                                    "properties": {
                                        "response": {
                                            "type": "array",
                                            "minItems": 0,
                                            "items": {
                                                "$ref": "../models/diskio-file.model.json"
                                            }
                                        }
                                    }                                    
                                }
                            ]
                        }
                    }
                }                
            }
        }
    },
    "post": {
        "tags": [ "DiskIO" ],
        "summary": "Upload a file",
        "requestBody": {
            "required": true,
            "content": {
                "multipart/form-data": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "files": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        },
                        "required": [
                            "files"
                        ]
                    }
                }
            }
        },
        "responses": {
            "200": {
                "description": "File names",
                "content": {
                    "application/json": {
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "../../common/response.model.json"
                                },
                                {
                                    "type": "object",
                                    "required": ["response"],
                                    "properties": {
                                        "response": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    }
}